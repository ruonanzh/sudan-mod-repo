# A mod page is not part of the mod. install_mod skips it.
**/.preview/
node_modules/
.DS_Store

# extracted vanilla art: DoubleCross owns it, it is a style reference only
reference/cards/*.png
reference/cards/head/

# extracted vanilla plates: DoubleCross owns them
reference/plates/*.png

# extracted vanilla fonts: commercial licences, reference only
reference/fonts/
.setup-venv/

# a workspace keeps its own mods here; the app refuses to sync a repo that tracks this
your_mods/
.gamer-agent.local.json

# decompiled game code lives outside repos: ~/decompiled
# this guard only blocks an accidental copy
decompiled/
